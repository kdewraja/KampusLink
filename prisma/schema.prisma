generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  profileId     String?   @unique
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  role          Role      @default(USER)

  profile       Profile?        @relation("UserProfile")
  sessions      Session[]
  verifications Verification[]
  sentLikes     Like[]          @relation("Liker")
  receivedLikes Like[]          @relation("Likee")
  matches       Match[]         @relation("MatchUser")
  matchedMatches Match[]        @relation("MatchMatchedUser")
  sentMessages  Message[]       @relation("MessageSender")
  conversations ConversationParticipant[]
  datePlans     DatePlan[]      @relation("DateInitiator")
  receivedDates DatePlan[]      @relation("DateRecipient")
  blocks        Block[]         @relation("Blocker")
  blockedBy     Block[]         @relation("Blocked")
  reports       Report[]        @relation("Reporter")
  reportedIn    Report[]        @relation("Reported")
  notifications Notification[]
  aiRequests    AIRequest[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Profile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  name                String
  age                 Int
  gender              Gender
  campus              String
  major               String
  batch               String
  hostel              String?
  bio                 String?
  relationshipIntent  RelationshipIntent
  isVerified          Boolean   @default(false)
  trustScore          Int       @default(75)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User              @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)
  photos              ProfilePhoto[]
  prompts             PromptAnswer[]
  interests           ProfileInterest[]
  clubs               ProfileClub[]
  campusAnthem        CampusAnthem?
  favoriteCampusSpot  String?
  twoAmCraving        String?
  freeTonight         FreeTonightStatus?

  @@map("profiles")
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  profileId String
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_photos")
}

model PromptAnswer {
  id        String   @id @default(cuid())
  profileId String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("prompt_answers")
}

model Interest {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  profiles  ProfileInterest[]

  @@map("interests")
}

model ProfileInterest {
  id         String   @id @default(cuid())
  profileId  String
  interestId String

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([profileId, interestId])
  @@map("profile_interests")
}

model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  campus    String?
  createdAt DateTime @default(now())

  profiles  ProfileClub[]

  @@map("clubs")
}

model ProfileClub {
  id        String   @id @default(cuid())
  profileId String
  clubId    String

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([profileId, clubId])
  @@map("profile_clubs")
}

model CampusAnthem {
  id        String   @id @default(cuid())
  profileId String   @unique
  title     String
  artist    String
  vibe      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("campus_anthems")
}

model FreeTonightStatus {
  id        String   @id @default(cuid())
  profileId String   @unique
  isActive  Boolean  @default(false)
  timeWindow String  @default("Tonight 8:00 PM - 10:30 PM")
  dateType  DateType @default(CAFE_COFFEE)
  area      String   @default("Central Campus")
  note      String?
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("free_tonight_status")
}

model Verification {
  id        String            @id @default(cuid())
  userId    String
  type      VerificationType
  email     String
  status    VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("verifications")
}

model Like {
  id              String   @id @default(cuid())
  likerId         String
  likeeId         String
  action          LikeAction
  comment         String?
  targetPromptId  String?
  targetPhotoUrl  String?
  createdAt       DateTime @default(now())

  liker           User     @relation("Liker", fields: [likerId], references: [id], onDelete: Cascade)
  likee           User     @relation("Likee", fields: [likeeId], references: [id], onDelete: Cascade)

  @@unique([likerId, likeeId])
  @@index([likeeId])
  @@index([createdAt])
  @@map("likes")
}

model Match {
  id            String   @id @default(cuid())
  userId        String
  matchedUserId String
  compatibilityScore Int
  createdAt     DateTime @default(now())

  user          User     @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser   User     @relation("MatchMatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)
  conversation  Conversation?

  @@unique([userId, matchedUserId])
  @@index([matchedUserId])
  @@map("matches")
}

model Conversation {
  id                  String   @id @default(cuid())
  compatibilityScore  Int?
  lastMessage         String?
  lastMessageAt       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  participants        ConversationParticipant[]
  messages            Message[]
  datePlans           DatePlan[]
  match               Match?   @relation(fields: [id], references: [id])

  @@index([createdAt])
  @@map("conversations")
}

model ConversationParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  hasUnread       Boolean  @default(false)
  lastReadAt      DateTime?
  joinedAt        DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String         @id @default(cuid())
  conversationId  String
  senderId        String
  text            String
  type            MessageType    @default(TEXT)
  promptComment   Json?
  datePlanId      String?
  isRead          Boolean        @default(false)
  readAt          DateTime?
  createdAt       DateTime       @default(now())

  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions       MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  type      String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@map("message_reactions")
}

model DatePlan {
  id          String       @id @default(cuid())
  initiatorId String
  recipientId String
  venueName   String
  venueType   String
  dateTime    DateTime
  notes       String?
  status      DatePlanStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  initiator   User         @relation("DateInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipient   User         @relation("DateRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [id], references: [id])

  @@index([initiatorId])
  @@index([recipientId])
  @@index([status])
  @@map("date_plans")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      ReportReason
  details     String?
  status      ReportStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime     @default(now())

  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
  @@map("reports")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AIRequest {
  id        String       @id @default(cuid())
  userId    String
  type      AIRequestType
  input     String
  output    String?
  tokensUsed Int?
  status    AIRequestStatus @default(COMPLETED)
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("ai_requests")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
}

enum RelationshipIntent {
  DATING_ROMANCE
  STUDY_DATE_BUDDY
  CAMPUS_HANGOUTS
  SERIOUS_RELATIONSHIP
}

enum DateType {
  CAFE_COFFEE
  CAMPUS_WALK
  STUDY_DATE
  CASUAL_FOOD
  EVENT_HANGOUT
}

enum VerificationType {
  EMAIL
  STUDENT_ID
  INSTITUTIONAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum LikeAction {
  LIKE
  PASS
  SUPER
}

enum MessageType {
  TEXT
  DATE_PROPOSAL
  PROMPT_COMMENT
  SYSTEM
}

enum DatePlanStatus {
  SUGGESTED
  PENDING
  ACCEPTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReportReason {
  INAPPROPRIATE_BEHAVIOR
  FAKE_PROFILE
  SPAM
  HARASSMENT
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_LIKE
  NEW_MATCH
  NEW_MESSAGE
  DATE_PROPOSAL
  DATE_ACCEPTED
  DATE_CONFIRMED
  DATE_CANCELLED
  PROFILE_VERIFIED
  SYSTEM
}

enum AIRequestType {
  GRAMMAR_CHECK
  TONE_ADJUST
  PROFILE_ASSIST
  PROMPT_SUGGEST
}

enum AIRequestStatus {
  PENDING
  COMPLETED
  FAILED
}